{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare sam pravi DNS zapis i SSL za ovaj domen pri deploy-u
  "routes": [{ "pattern": "studio.aiprofit.rs", "custom_domain": true }],

  // Stranice iz public/. /ponuda služi ponuda.html. /api/* ide u Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creator-studio",
      "database_id": "2bd23a05-d4bf-444a-9de5-52fc5d9833dc",
      "migrations_dir": "migrations"
    }
  ],

  // Isporuka posle kupovine ide kroz red, da webhook odgovori Stripe-u odmah.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "studio-jobs" }],
    "consumers": [
      { "queue": "studio-jobs", "max_batch_size": 5, "max_retries": 5, "dead_letter_queue": "studio-jobs-dlq" }
    ]
  },

  // Noćna provera: Stripe naplate iz poslednjih 48h moraju da postoje u bazi.
  "triggers": { "crons": ["0 3 * * *"] },

  "vars": {
    // launch | evergreen
    "MODE": "launch",
    // Do kada važi 67€, i kad se vrata zatvaraju (isto kao CONFIG.deadline u public/script.js)
    "LAUNCH_UNTIL": "2026-11-11T21:00:00+01:00",
    "CLOSE_AT": "2026-11-15T21:00:00+01:00",
    "AUTOMATIC_TAX": "false",
    // Javni Stripe ključ (pk_...), treba samo za 3DS potvrdu na /ponuda
    "STRIPE_PUBLISHABLE_KEY": "pk_test_51TZnpX3qt764ELv7MvJNdVPxJ6ihgB7gzGlKU0jilxQKb5DTZ2dgLBhXXFQHxDlBG5aTvffg0EjYwWbrQCULv3xI00fjbSaDD2",
    // Stripe Customer Portal: Lab član sam otkazuje ili menja karticu
    "STRIPE_PORTAL_URL": "https://billing.stripe.com/p/login/test_4gM7sEea56162wueiKd7q00",

    // Circle (aiprofit.rs): access grupe i link kursa
    "CIRCLE_STUDIO_GROUP": "167621",
    "CIRCLE_LAB_GROUP": "167622",
    // Grupa koju daje Circle Paywall postojećim Lab članovima (za proveru "već je član")
    "CIRCLE_PAYWALL_LAB_GROUP": "124997",
    "CIRCLE_STUDIO_URL": "https://www.aiprofit.rs/c/studio-reel-lab-kurs",

    // Transakcioni mejlovi (Resend). Domen pošiljaoca mora biti potvrđen u Resend-u.
    "MAIL_FROM": "Studio Reel Lab <studio@aiprofit.rs>",
    "MAIL_REPLY_TO": "podrska@vladsdigital.com",

    // MailerLite grupe (napravio scripts/setup.mjs mailerlite)
    "ML_GROUP_STUDIO": "202394703090419309",
    "ML_GROUP_LAB": "202394703402894907",
    "ML_GROUP_LAB_EX": "202394703679719016",

    // WooCommerce (vladsdigital.com), samo evidencija (scripts/setup.mjs woo)
    "WOO_URL": "https://vladsdigital.com",
    "WOO_PRODUCT_STUDIO": "45406",
    "WOO_PRODUCT_LAB": "45407"
  },

  "observability": { "enabled": true }
}
